{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "WebSearch",
      "WebFetch",
      "Bash(git add *)"
    ],
    "deny": [
      "Bash(cat .env*)",
      "Bash(curl *|* sh*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)",
      "Bash(wget *|* sh*)",
      "Read(.env)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/user/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "model": "opus",
  "effortLevel": "medium"
}